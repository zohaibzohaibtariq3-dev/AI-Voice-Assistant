# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for chat responses
GROQ_MODEL=llama-3.3-70b-versatile

# faster-whisper model size: tiny | base | small | medium | large-v3
# Smaller = faster but less accurate. "base" is a good balance for a demo/laptop.
WHISPER_MODEL_SIZE=base

# System prompt controlling the assistant's personality/behavior
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep replies short (2-4 sentences) and conversational, since they will be read aloud.

# Local server port
PORT=5000
